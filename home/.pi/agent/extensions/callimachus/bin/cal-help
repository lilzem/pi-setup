#!/usr/bin/env bash
set -euo pipefail
dir="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
section="$(node --no-warnings -e '
const [dir, topic] = process.argv.slice(1);
import(`${dir}/guide.ts`).then(({ guideSection }) => {
  const guide = require("node:fs").readFileSync(`${dir}/GUIDE.md`, "utf8");
  process.stdout.write(guideSection(guide, topic ?? "").replaceAll("/cal-help", "cal-help"));
});' "$dir" "${1:-}")"
if command -v glow >/dev/null && [ -t 1 ]; then
  printf '%s\n' "$section" | glow -
else
  printf '%s\n' "$section"
fi
